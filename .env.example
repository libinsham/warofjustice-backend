# ---- Django core ----
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database: PostgreSQL (local) ----
# Fill these in to match the database/user you already created locally.
# If you haven't created one yet:
#   psql -U postgres
#   CREATE USER newshub_user WITH PASSWORD 'your_password_here';
#   CREATE DATABASE newshub OWNER newshub_user;
DB_ENGINE=postgres
DB_NAME=newshub
DB_USER=newshub_user
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# ---- CORS / CSRF (Next.js frontend origin) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ---- Frontend URL (used to build links inside emails, e.g. password reset) ----
FRONTEND_URL=http://localhost:3000

# ---- Email ----
# Defaults to printing emails to the console (safe for local dev, sends
# nothing real). For production, switch to SMTP and fill in your
# provider's details (SendGrid/Mailgun/SES/etc. all support SMTP):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=NEWSHUB <no-reply@newshub.example.com>

# ---- Cloudflare R2 (images/files) ----
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=newshub-media
R2_PUBLIC_BASE_URL=https://media.yourdomain.com

# ---- Bunny Stream (video) ----
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxxxxx.b-cdn.net
BUNNY_WEBHOOK_SECRET=change-me-to-a-random-string
